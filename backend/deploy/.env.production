# Arquivo de ambiente para produção na Oracle Cloud
# Copie este arquivo para .env e configure as variáveis

# Database
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=SuaSenhaSeguraAqui123!
MONGO_USER=lushamm_user
MONGO_PASSWORD=SuaSenhaLushamm456!
MONGO_CONNECTION_STRING=mongodb://lushamm_user:SuaSenhaLushamm456!@localhost:27017/lushamm?authSource=lushamm

# JWT
JWT_SECRET=SeuJWTSecretMuitoSeguroEComplexo789!

# Frontend
FRONTEND_URL=https://seudominio.com

# Upload paths
UPLOAD_PATH=./uploads
TEMP_PATH=./temp

# Image compression settings
MAX_IMAGE_SIZE_MB=10
COMPRESSED_IMAGE_SIZE_MB=1
DEFAULT_IMAGE_QUALITY=80
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080

# Server
NODE_ENV=production
PORT=3001

# Oracle Cloud specific
ORACLE_CLOUD_IP=SeuIPPublico
DOMAIN=seudominio.com
